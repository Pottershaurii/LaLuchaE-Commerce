{
  "uid": "lalucha-observabilidad",
  "title": "UTP - Observabilidad Proyecto Final (La Lucha)",
  "description": "Las 4 señales doradas (saturación, tráfico, latencia y errores/estado) del API lalucha-api.",
  "tags": [
    "lalucha",
    "sre",
    "sesion30"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "1. Saturación · CPU del API (%)",
      "description": "Uso de CPU del proceso Java (process_cpu_usage). Verde < 70 %, ámbar 70-85 %, rojo > 85 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lalucha"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lalucha"
          },
          "expr": "process_cpu_usage{job=\"lalucha_api\"} * 100",
          "legendFormat": "CPU",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "1. Saturación · Memoria heap (%)",
      "description": "Memoria heap usada de la JVM sobre el máximo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lalucha"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lalucha"
          },
          "expr": "sum(jvm_memory_used_bytes{job=\"lalucha_api\", area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"lalucha_api\", area=\"heap\"} > 0) * 100",
          "legendFormat": "Heap",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "2. Tráfico · peticiones por segundo (RPS)",
      "description": "Peticiones HTTP por segundo al API (sin contar las lecturas de Prometheus), total y por código de estado.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lalucha"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lalucha"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"lalucha_api\", uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "RPS total",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lalucha"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"lalucha_api\", uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "3. Latencia · percentil 95 (s)",
      "description": "p95 del tiempo de respuesta. Verde < 0.3 s, ámbar 0.3-1.0 s, rojo > 1.0 s. El SLA del proyecto exige p95 < 0.5 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lalucha"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lalucha"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"lalucha_api\", uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p95",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errores 5xx (%)",
      "description": "Porcentaje de respuestas 5xx (0 % cuando no hay errores). La alerta crítica se dispara sobre 5 % sostenido 1 minuto.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lalucha"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lalucha"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"lalucha_api\", uri!~\"/actuator.*\", status=~\"5..\"}[1m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"lalucha_api\", uri!~\"/actuator.*\"}[1m])), 0.001) * 100",
          "legendFormat": "5xx %",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "4. Estado del servicio (verde = UP, rojo = DOWN)",
      "description": "1 = UP (verde), 0 = DOWN (rojo). Lo mide Prometheus en cada lectura.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lalucha"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lalucha"
          },
          "expr": "up{job=\"lalucha_api\"}",
          "legendFormat": "lalucha-api",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "center",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "4. Historial de alertas FIRING (Prometheus)",
      "description": "Alertas en estado FIRING. Cada una genera un ticket automático en el módulo de incidentes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lalucha"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lalucha"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{alertname}} · {{priority}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "FIRING",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "noValue": "Sin alertas activas"
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "center",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Conexiones a PostgreSQL (HikariCP)",
      "description": "Conexiones activas, ociosas y máximo del pool (10 por instancia).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lalucha"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lalucha"
          },
          "expr": "max(hikaricp_connections_active{job=\"lalucha_api\"})",
          "legendFormat": "activas",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lalucha"
          },
          "expr": "max(hikaricp_connections_idle{job=\"lalucha_api\"})",
          "legendFormat": "ociosas",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lalucha"
          },
          "expr": "max(hikaricp_connections_max{job=\"lalucha_api\"})",
          "legendFormat": "máximo",
          "refId": "C",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
