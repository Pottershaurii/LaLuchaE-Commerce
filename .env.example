DB_HOST=localhost
DB_PORT=5432
DB_NAME=lalucha
DB_USER=lalucha_app
DB_PASSWORD=cambiar_esta_clave
DB_SCHEMA=lalucha

# --- Backend (Spring Boot) ---
# Spring no lee este archivo: define estas variables en tu sistema o en la
# configuracion de ejecucion del IDE. Si no existen, usa los valores locales.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=lalucha
DB_USERNAME=postgres
DB_PASSWORD=cambiar_esta_clave
JWT_SECRET=cambiar_por_una_clave_larga_de_al_menos_32_caracteres
MAIL_USERNAME=correo@gmail.com
MAIL_PASSWORD=clave_de_aplicacion_de_gmail

# --- Observabilidad (docker-compose.monitoring.yml, Sesion 30) ---
# Clave del usuario admin de Grafana
GRAFANA_ADMIN_PASSWORD=cambiar_esta_clave
# Token compartido entre Alertmanager y el API para crear tickets automaticos.
# Debe ser igual al contenido de monitoring/secretos/alertas_token.
ALERTAS_WEBHOOK_TOKEN=cambiar_por_un_token_largo
# Usuario (STAFF o ADMIN) que figura como quien reporta los tickets automaticos
ALERTAS_USUARIO_EMAIL=soporte@lalucha.pe
